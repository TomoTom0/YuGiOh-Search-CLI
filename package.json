{
  "name": "ygo-search",
  "version": "1.3.0",
  "description": "CLI tools for Yu-Gi-Oh card search with local database",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "ygo_search": "./dist/cli/ygo_search.js",
    "ygo_convert": "./dist/cli/ygo_convert.js"
  },
  "files": [
    "dist",
    "data",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "swc src -d dist --ignore '**/*.test.ts' && mv dist/src/* dist/ && rmdir dist/src && chmod +x dist/cli/*.js && tsc --emitDeclarationOnly",
    "prebuild": "rm -rf dist",
    "prepublishOnly": "bun run build",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "mcp",
    "yugioh"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "js-yaml": "^4.1.1",
    "jsonc-parser": "^3.3.1",
    "tsx": "^4.20.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@swc/cli": "^0.7.9",
    "@swc/core": "^1.15.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.10.1",
    "typescript": "^5.7.3",
    "vitest": "^4.0.10"
  }
}
