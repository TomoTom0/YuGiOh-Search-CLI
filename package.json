{
  "name": "ygo-search",
  "version": "1.4.0",
  "description": "CLI tools for Yu-Gi-Oh card search with local database",
  "type": "module",
  "packageManager": "pnpm@10.26.2",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "ygo-search": "./dist/cli/ygo_search.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "swc src -d dist --ignore '**/*.test.ts' && mv dist/src/* dist/ && rmdir dist/src && chmod +x dist/cli/*.js && tsc --emitDeclarationOnly",
    "prebuild": "rm -rf dist",
    "prepublishOnly": "pnpm run build",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "mcp",
    "yugioh",
    "card-search",
    "ocg",
    "cli"
  ],
  "author": "TomoTom0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TomoTom0/ygo-search.git"
  },
  "homepage": "https://github.com/TomoTom0/ygo-search#readme",
  "bugs": {
    "url": "https://github.com/TomoTom0/ygo-search/issues"
  },
  "license": "MIT",
  "dependencies": {
    "@lancedb/lancedb": "^0.23.0",
    "@xenova/transformers": "^2.17.2",
    "js-yaml": "^4.1.1",
    "jsonc-parser": "^3.3.1",
    "tsx": "^4.20.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260117.0",
    "@swc/cli": "^0.7.9",
    "@swc/core": "^1.15.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.10.1",
    "typedoc": "^0.28.15",
    "typedoc-plugin-markdown": "^4.9.0",
    "typescript": "^5.7.3",
    "vitest": "^4.0.10",
    "wrangler": "^4.76.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@lancedb/lancedb",
      "@swc/core",
      "@xenova/transformers",
      "esbuild",
      "workerd"
    ]
  }
}
